LOG_LEVEL=10
JOIN_ON_INVITE=True
SALT=b"\xce,\xa1\xc6lY\x80\xe3X}\x91\xa60m\xa8N"
MATRIX_HOME_SERVER="https://matrix.agent.ministere_example.tchap.gouv.fr"
MATRIX_BOT_USERNAME="jean.quidam@ministere_example.gouv.fr"
MATRIX_BOT_PASSWORD="test"
ERRORS_ROOM_ID="!aaaaaaaaa:agent.ministere_example.tchap.gouv.fr"
USER_ALLOWED_DOMAINS='["ministere_example.gouv.fr", "ministere_example2.gouv.fr"]'
GROUPS_USED='["basic", "albert"]'

# Configuration des APIs
ALBERT_API_URL=https://api.albert.ai
ALBERT_API_TOKEN=votre_token_albert
ALBERT_MODEL=AgentPublic/albertlight-7b
ALBERT_MODEL_EMBEDDING=albert-embedding-v2

# Configuration des embeddings
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_SIZE=10000
EMBEDDING_CACHE_DURATION=24
EMBEDDING_BATCH_SIZE=20

# Configuration de l'index
INDEX_DIR=.index
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Configuration WebDAV
WEBDAV_URL=https://votre.serveur.webdav
WEBDAV_USERNAME=utilisateur
WEBDAV_PASSWORD=mot_de_passe
WEBDAV_ROOT_PATH=/documents
WEBDAV_INDEX_NAME=index.json

# Configuration du mode RAG
ALBERT_MODE=rag
ALBERT_WITH_HISTORY=true
ALBERT_HISTORY_LOOKUP=0
ALBERT_MAX_REWIND=20
