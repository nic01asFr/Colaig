# Configuration Matrix/Tchap
MATRIX_HOME_SERVER=https://matrix.dev01.tchap.incubateur.net
MATRIX_BOT_USERNAME=@votre_utilisateur:dev01.tchap.incubateur.net
MATRIX_BOT_PASSWORD=votre_mot_de_passe
USER_ALLOWED_DOMAINS=["votre_domaine.gouv.fr"]
ERRORS_ROOM_ID="!votre_salon_erreurs:dev01.tchap.incubateur.net"
GROUPS_USED=basic,albert,document

# Configuration Albert API
ALBERT_API_URL=https://api.albert.etalab.gouv.fr/v1
ALBERT_API_TOKEN=votre_token_api
ALBERT_MODEL=meta-llama/Llama-3.1-8B-Instruct
ALBERT_MODEL_EMBEDDING=BAAI/bge-m3

# Configuration WebDAV (production)
WEBDAV_URL=https://votre_serveur_webdav.gouv.fr
WEBDAV_USERNAME=votre_utilisateur_webdav
WEBDAV_PASSWORD=votre_mot_de_passe_webdav
WEBDAV_ROOT_PATH=/documents

# Configuration WebDAV (développement)
WEBDAV_DEV_USERNAME=albert
WEBDAV_DEV_PASSWORD=password 