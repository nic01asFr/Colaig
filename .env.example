# ============================================================
# Colaig - Configuration
# ============================================================
# Mode single-bot : python -m app
# Mode platform   : python -m platform
# ============================================================

# === Matrix / Tchap (single-bot mode) ===
MATRIX_HOME_SERVER=https://matrix.agent.dev-durable.tchap.gouv.fr
MATRIX_BOT_USERNAME=@colaig.assistant-developpement-durable.gouv.fr:agent.dev-durable.tchap.gouv.fr
MATRIX_BOT_PASSWORD=mot_de_passe_colaig
USER_ALLOWED_DOMAINS=["votre_domaine.gouv.fr"]
ERRORS_ROOM_ID="!votre_salon_erreurs:dev01.tchap.incubateur.net"
GROUPS_USED=basic,albert,document

# === Albert API ===
ALBERT_API_URL=https://api.albert.etalab.gouv.fr/v1
ALBERT_API_TOKEN=votre_token_api
ALBERT_MODEL=meta-llama/Llama-3.1-8B-Instruct
ALBERT_MODEL_EMBEDDING=BAAI/bge-m3

# === WebDAV ===
WEBDAV_URL=https://mel.din.developpement-durable.gouv.fr/mdrive/remote.php/dav/files/colaig.assistant
WEBDAV_USERNAME=colaig.assistant
WEBDAV_PASSWORD=mot_de_passe_colaig
WEBDAV_ROOT_PATH=/dossier_racine_de_l_espace_de_travail

# === Extraction web ===
ALLOW_FALLBACK_EXTRACTION=True

# ============================================================
# Platform mode (python -m platform)
# ============================================================

# --- Session & Admin ---
# Secret pour signer les cookies de session (minimum 32 caractères)
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
PLATFORM_SESSION_SECRET=
# Mot de passe admin pour le mode dev/test (quand ProConnect n'est pas actif)
PLATFORM_ADMIN_PASSWORD=
# Emails des opérateurs DINUM (rôle operator, séparés par des virgules)
PLATFORM_OPERATOR_EMAILS=admin@example.gouv.fr
# Chemin de la base SQLite
PLATFORM_DB_PATH=/code/data/platform.db

# --- ProConnect OIDC ---
# Mettre PROCONNECT_ENABLED=true quand les credentials DataPass sont reçus
PROCONNECT_ENABLED=false
PROCONNECT_CLIENT_ID=
PROCONNECT_CLIENT_SECRET=
PROCONNECT_REDIRECT_URI=https://votre-domaine.gouv.fr/auth/callback
PROCONNECT_ISSUER=https://auth.proconnect.gouv.fr/api/v2

# ============================================================
# Notes d'installation
# ============================================================
# Après l'installation des dépendances, exécutez:
# python scripts/install_playwright.py
#
# Pour le mode platform (multi-instance) :
# docker compose -f docker-compose.platform.yml up -d
#
# Pour le mode single-bot (legacy) :
# docker compose up -d
