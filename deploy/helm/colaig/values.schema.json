{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "description": "Image container",
      "properties": {
        "repository": {
          "type": "string",
          "default": "",
          "title": "Registre de l'image",
          "description": "Ou l'image Colaig est publiee, par exemple ghcr.io/<organisation>/colaig. Obligatoire."
        },
        "tag": {
          "type": "string",
          "default": "latest"
        }
      }
    },
    "llm": {
      "type": "object",
      "description": "Modele de langage (OpenAI-compatible)",
      "properties": {
        "backend": {
          "type": "string",
          "title": "Backend LLM",
          "enum": [
            "openai",
            "albert"
          ],
          "default": "openai"
        },
        "apiUrl": {
          "type": "string",
          "title": "URL de l'API LLM",
          "description": "Base SANS /v1 : le client ajoute lui-meme /v1/chat/completions. SSP Cloud : https://llm.lab.sspcloud.fr/api (verifie le 29/08/2026 — la valeur precedente, /openai, ne correspondait ni au profil Onyxia ni aux mesures).",
          "default": "https://llm.lab.sspcloud.fr/api"
        },
        "apiKey": {
          "type": "string",
          "title": "Cle API LLM",
          "description": "Token du LLM (SSP Cloud : depuis llm.lab.sspcloud.fr)",
          "default": "",
          "x-security": "password"
        },
        "modelChat": {
          "type": "string",
          "title": "Modele de chat",
          "description": "Vide = defaut du serveur",
          "default": ""
        },
        "modelEmbed": {
          "type": "string",
          "title": "Modele d'embeddings",
          "description": "Vide + localEmbeddings=true => embeddings calcules en local",
          "default": ""
        },
        "localEmbeddings": {
          "type": "boolean",
          "title": "Embeddings locaux (fallback)",
          "description": "Active si le LLM n'expose pas d'endpoint embeddings (charge bge-m3 dans le pod)",
          "default": true
        },
        "existingSecret": {
          "type": "string",
          "title": "Secret Kubernetes existant",
          "description": "Nom d'un Secret portant LLM_API_KEY. Renseigne, la cle ne transite pas par les valeurs Helm — que le cluster conserve en clair.",
          "default": ""
        }
      }
    },
    "storage": {
      "type": "object",
      "description": "Stockage des documents et index (S3/MinIO)",
      "properties": {
        "backend": {
          "type": "string",
          "title": "Backend storage",
          "enum": [
            "s3",
            "local"
          ],
          "default": "s3"
        },
        "s3": {
          "type": "object",
          "properties": {
            "endpointUrl": {
              "type": "string",
              "title": "Endpoint S3",
              "default": ""
            },
            "accessKey": {
              "type": "string",
              "title": "Access key",
              "default": ""
            },
            "secretKey": {
              "type": "string",
              "title": "Secret key",
              "default": "",
              "x-security": "password"
            },
            "sessionToken": {
              "type": "string",
              "title": "Session token (STS)",
              "default": "",
              "x-security": "password"
            },
            "bucket": {
              "type": "string",
              "title": "Bucket",
              "default": ""
            },
            "prefix": {
              "type": "string",
              "title": "Prefixe",
              "default": "colaig"
            },
            "region": {
              "type": "string",
              "title": "Region",
              "default": "us-east-1"
            }
          }
        }
      }
    },
    "messaging": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "title": "Canal de messagerie",
          "enum": [
            "webchat",
            "matrix",
            "telegram"
          ],
          "default": "webchat"
        }
      }
    },
    "platformApiKey": {
      "type": "string",
      "title": "Cle d'administration",
      "description": "Protege le dashboard et les routes plateforme (vide = acces libre)",
      "default": "",
      "x-security": "password"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Exposer via Ingress",
          "default": false
        },
        "hostname": {
          "type": "string",
          "title": "Nom d'hote",
          "default": ""
        },
        "className": {
          "type": "string",
          "title": "IngressClass",
          "default": ""
        }
      }
    },
    "ai": {
      "type": "object",
      "title": "AI Assistant",
      "description": "Identifiants de la passerelle IA, remplis par Onyxia au lancement depuis votre session OIDC et votre profil personnalisable. Laisser llm.apiKey vide pour les utiliser.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Utiliser la passerelle IA d'Onyxia",
          "default": false,
          "x-onyxia": {
            "overwriteDefaultWith": "{{ai.enabled}}"
          }
        },
        "activeProvider": {
          "type": "object",
          "default": {},
          "properties": {
            "apiBase": {
              "type": "string",
              "default": "",
              "x-onyxia": {
                "overwriteDefaultWith": "{{ai.activeProvider.apiBase}}"
              }
            },
            "apiKey": {
              "type": "string",
              "default": "",
              "x-security": "password",
              "x-onyxia": {
                "overwriteDefaultWith": "{{ai.activeProvider.apiKey}}"
              }
            },
            "selectedModel": {
              "type": "string",
              "listEnum": [],
              "default": "",
              "x-onyxia": {
                "overwriteDefaultWith": "{{ai.activeProvider.selectedModel}}",
                "overwriteListEnumWith": "{{ai.activeProvider.models}}"
              }
            }
          }
        }
      }
    }
  }
}