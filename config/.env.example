# Colaig — Variables d'environnement
# Copier en .env (a la racine du projet) et remplir les valeurs.
# Regle generale : ENV > config/default.yml > defaults internes.
#
# Colaig est provider-agnostic : on choisit UN backend par couche
# (storage / messaging / llm) puis on remplit uniquement ses credentials.

# =============================================================================
# CHOIX DES BACKENDS (obligatoire)
# =============================================================================
STORAGE_BACKEND=local        # local | webdav | bigfolder | s3 | msgraph | box | gdrive
MESSAGING_BACKEND=webchat    # webchat | matrix | telegram
LLM_BACKEND=albert           # albert | openai | azure | ollama | mistral | groq

# =============================================================================
# LLM — Albert API (souverain, Etalab/DINUM) — defaut
# =============================================================================
ALBERT_API_URL=https://albert.api.etalab.gouv.fr
ALBERT_API_KEY=
ALBERT_MODEL_CHAT=openai/gpt-oss-120b
ALBERT_MODEL_EMBED=BAAI/bge-m3
ALBERT_MODEL_LIGHT=mistralai/Ministral-3-8B-Instruct-2512
ALBERT_MODEL_RERANK=BAAI/bge-reranker-v2-m3

# --- LLM generique (si LLM_BACKEND=openai|azure|ollama|mistral|groq) ---
# Pointez ici un endpoint OpenAI-compatible (SSP Cloud, vLLM, Mistral...).
# IMPORTANT : un endpoint d'embeddings est requis ; sinon activez le fallback
# local SentenceTransformer via COLAIG_LOCAL_EMBEDDINGS=true.
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL_CHAT=
# LLM_MODEL_EMBED=
# COLAIG_LOCAL_EMBEDDINGS=false   # true = fallback SentenceTransformer local (bge-m3)

# =============================================================================
# STORAGE — selon STORAGE_BACKEND
# =============================================================================
# --- local ---
LOCAL_STORAGE_PATH=./data/storage

# --- webdav (Nextcloud / Bnum) ---
# WEBDAV_URL=https://bnum.din.gouv.fr/remote.php/dav/files/colaig/
# WEBDAV_USERNAME=colaig
# WEBDAV_PASSWORD=

# --- bigfolder (API Archivist) ---
# BIGFOLDER_API_URL=http://localhost:8002
# BIGFOLDER_SERVICE_TOKEN=svc_xxxxx
# BIGFOLDER_ROOT=/

# --- s3 / minio (compatible SSP Cloud) ---
# S3_ENDPOINT_URL=https://minio.example.org
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SESSION_TOKEN=          # requis pour credentials STS temporaires (SSP Cloud)
# S3_BUCKET_NAME=
# S3_PREFIX=
# S3_REGION=us-east-1

# --- msgraph (OneDrive / SharePoint) ---
# MSGRAPH_TENANT_ID=
# MSGRAPH_CLIENT_ID=
# MSGRAPH_CLIENT_SECRET=
# MSGRAPH_DRIVE_USER_ID=

# --- box (JWT Server Auth) ---
# BOX_CONFIG_FILE=/secrets/box-config.json

# --- gdrive (Service Account JWT) ---
# GDRIVE_SERVICE_ACCOUNT_JSON=/secrets/gdrive-sa.json
# GDRIVE_ROOT_FOLDER_ID=root

# =============================================================================
# MESSAGING — selon MESSAGING_BACKEND
# =============================================================================
# --- webchat : aucune config externe (interface /chat dans le navigateur) ---

# --- matrix / tchap ---
# MATRIX_HOMESERVER=https://matrix.agent.tchap.gouv.fr
# MATRIX_USERNAME=@colaig:agent.tchap.gouv.fr
# MATRIX_PASSWORD=

# --- telegram ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=

# =============================================================================
# APPLICATION
# =============================================================================
COLAIG_LOG_LEVEL=INFO
COLAIG_DATA_DIR=/app/data
COLAIG_WEB_PORT=8000
# Cle d'administration du dashboard web + routes plateforme (Bearer).
# Vide = acces libre (dev/self-hosted). Definir IMPERATIVEMENT en production.
# COLAIG_PLATFORM_API_KEY=

# =============================================================================
# PIPELINE AGENTS (optionnel — Phase 2+)
# =============================================================================
# COLAIG_AGENTS_ENABLED=false
# COLAIG_MCP_ENABLED=false
# COLAIG_ORCHESTRATOR_MAX_ITERATIONS=5

# =============================================================================
# RAG HYBRIDE (optionnel — opt-in)
# =============================================================================
# COLAIG_HYBRID_SEARCH_ENABLED=true
# COLAIG_CONTEXTUAL_CHUNKING_ENABLED=true
# COLAIG_HYDE_ENABLED=true

# =============================================================================
# AUTH MCP OIDC (optionnel — entreprise)
# =============================================================================
# COLAIG_MCP_AUTH_ENABLED=true
# COLAIG_MCP_AUTH_MODE=oidc
# COLAIG_OIDC_ISSUER=https://sso.org.fr/realms/org
# COLAIG_OIDC_AUDIENCE=colaig-instance
# COLAIG_OIDC_JWKS_URI=https://sso.org.fr/realms/org/protocol/openid-connect/certs
